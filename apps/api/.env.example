# Copy to apps/api/.env for local development. Never commit .env.
# Matches the local Postgres started by `pnpm db:up` (docker-compose.yml).
DATABASE_URL=postgres://gainframe:gainframe@localhost:5432/gainframe
# The dev user pool, so tokens from the dev site work against a local API:
# AUTH_ISSUER is https://cognito-idp.ap-southeast-1.amazonaws.com/<user pool ID>
# and AUTH_CLIENT_ID the web client; both are in the SSM parameter
# /gainframe/dev/auth-config. Routes other than /api/health need them.
AUTH_ISSUER=https://cognito-idp.ap-southeast-1.amazonaws.com/replace-me
AUTH_CLIENT_ID=replace-me
