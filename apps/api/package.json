{
  "name": "@gainframe/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/dev.ts",
    "typecheck": "tsc",
    "build": "rolldown -c rolldown.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate-cli.ts",
    "eval:vision": "node --env-file-if-exists=.env evals/vision/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "1.1.3",
    "@anthropic-ai/sdk": "1.12.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1175.0",
    "@aws-sdk/client-ssm": "3.1175.0",
    "@gainframe/shared": "workspace:*",
    "@hono/aws-lambda": "1.0.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.19",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.11",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "rolldown": "1.3.3"
  }
}
